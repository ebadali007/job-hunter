# ==============================================================
# GLOBAL JOB HUNTER AI AUTOMATION - CONFIGURATION (.env)
# ==============================================================

# --- AI Brain (Strict 100% Free Tiers) ---
# Get free Gemini API key from: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional Backup: Get free Groq API key from: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Candidate Profile Settings ---
CANDIDATE_NAME=Senior Full-Stack & Mobile Engineer
CANDIDATE_EMAIL=candidate@example.com
CANDIDATE_PHONE=+1234567890
CANDIDATE_LOCATION=Worldwide Remote / Open to Relocation
CANDIDATE_LINKEDIN=https://linkedin.com/in/yourprofile
CANDIDATE_GITHUB=https://github.com/yourprofile
CANDIDATE_PORTFOLIO=https://yourportfolio.dev

# --- Job Hunting & Matching Filters ---
MATCH_THRESHOLD=75
TARGET_ROLES=Full-Stack Developer, Frontend Engineer, Mobile App Developer, React Native Developer, Flutter Developer, Next.js Developer
TARGET_LOCATIONS=Worldwide Remote, United States, Canada, United Kingdom, Europe, Germany, Netherlands, UAE, Dubai, Australia
MIN_SALARY_USD=0

# --- Autonomous Auto-Pilot & 24h Freshness Filter ---
MAX_JOB_AGE_HOURS=24
AUTO_PILOT_ENABLED=true
AUTO_PILOT_INTERVAL_MINUTES=60
AUTO_APPLY_ENABLED=true
AUTO_APPLY_MIN_SCORE=75

# --- Email Notifications & Recruiter Inbox Tracker ---
# Gmail credentials (use 16-digit App Password from Google Account Security > 2-Step Verification)
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL=
ENABLE_EMAIL_DIGEST=false
ENABLE_RECRUITER_TRACKER=false
DAILY_DIGEST_TIME=09:00

# --- Dashboard & Server ---
HOST=127.0.0.1
PORT=8050
DEBUG=true
